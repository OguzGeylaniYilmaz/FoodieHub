@model List<ResultGroupReservationDto>

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="mb-0">
                    <i class="fas fa-calendar-check text-primary"></i>
                    Group Reservations
                </h4>

                <div class="card-header-form">
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control" placeholder="Search reservation...">
                        <div class="input-group-append">
                            <button class="btn btn-primary">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="thead-light">
                            <tr>
                                <th class="text-center">
                                    <input type="checkbox" id="checkbox-all">
                                </th>
                                <th>Group</th>
                                <th>Contact</th>
                                <th class="text-center">People</th>
                                <th>Status</th>
                                <th>Reservation</th>
                                <th>Due</th>
                                <th>Priority</th>
                                <th class="text-center">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var reservation in Model)
                            {
                                <tr>
                                    <td class="text-center">
                                        <input type="checkbox">
                                    </td>

                                    <td>
                                        <strong>@reservation.GroupTitle</strong>
                                    </td>

                                    <td>
                                        <i class="fas fa-user text-muted"></i>
                                        @reservation.PersonToContact
                                    </td>

                                    <td class="text-center">
                                        <span class="badge badge-info">
                                            <i class="fas fa-users"></i>
                                            @reservation.PersonCount
                                        </span>
                                    </td>

                                    <td>
                                        @{
                                            var statusClass = reservation.ReservationStatus switch
                                            {
                                                "Approved" => "badge-success",
                                                "Pending" => "badge-warning",
                                                "Cancelled" => "badge-danger",
                                                _ => "badge-secondary"
                                            };
                                        }

                                        <span class="badge @statusClass">
                                            <i class="fas fa-info-circle"></i>
                                            @reservation.ReservationStatus
                                        </span>
                                    </td>

                                    <td>
                                        <i class="far fa-calendar-alt text-muted"></i>
                                        @reservation.ReservationDate.ToString("dd MMM yyyy HH:mm")
                                    </td>

                                    <td>
                                        <i class="fas fa-hourglass-end text-muted"></i>
                                        @reservation.DueDate.ToString("dd MMM yyyy HH:mm")
                                    </td>

                                    <td>
                                        @{
                                            var priorityClass = reservation.Priority switch
                                            {
                                                "High" => "badge-danger",
                                                "Medium" => "badge-warning",
                                                "Low" => "badge-success",
                                                _ => "badge-secondary"
                                            };
                                        }

                                        <span class="badge @priorityClass">
                                            <i class="fas fa-flag"></i>
                                            @reservation.Priority
                                        </span>
                                    </td>

                                    <td class="text-center">
                                        <a href="#" class="btn btn-sm btn-outline-primary" title="Detail">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a href="#" class="btn btn-sm btn-outline-warning" title="Edit">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a href="#" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="fas fa-trash-alt"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
