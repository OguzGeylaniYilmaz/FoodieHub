@model List<ResultProductDto>

<div class="tab-content" data-aos="fade-up" data-aos-delay="200">

    @foreach (var category in Model.Select(x => new { x.CategoryID, x.CategoryName }).Distinct())
    {
        <div class="tab-pane fade @(category.CategoryID == Model.First().CategoryID ? "active show" : "")"
             id="category-@category.CategoryID">

            <div class="tab-header text-center">
                <p>Menu</p>
                <h3>@category.CategoryName</h3>
            </div>

            <div class="row gy-5">
                @foreach (var item in Model.Where(x => x.CategoryID == category.CategoryID))
                {
                    <div class="col-lg-4 menu-item">
                        <a href="#" class="glightbox">
                            <img src="@item.ImageUrl" class="menu-img img-fluid" alt="">
                        </a>
                        <h4>@item.ProductName</h4>
                        <p class="ingredients">@item.Description</p>
                        <p class="price">$@item.Price</p>
                    </div>
                }
            </div>

        </div>
    }

</div>
