@model List<ResultChefDto>
@{
    ViewData["Title"] = "ChefList";
    Layout = "~/Views/Admin/Index.cshtml";
}

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="fas fa-user-chef text-danger mr-2"></i>
                            Chefs
                        </h4>

                        <a href="/Chef/CreateChef"
                           class="btn btn-success btn-sm">
                            <i class="fas fa-plus mr-1"></i>
                            New Chef
                        </a>
                    </div>

                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="thead-light">
                                    <tr>
                                        <th style="width:60px;">#</th>
                                        <th>Chef</th>
                                        <th>Title</th>
                                        <th>Description</th>
                                        <th class="text-right" style="width:180px;">Actions</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @if (!Model.Any())
                                    {
                                        <tr>
                                            <td colspan="5" class="text-center text-muted py-4">
                                                No chefs found
                                            </td>
                                        </tr>
                                    }

                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="font-weight-bold">
                                                @item.ChefID
                                            </td>

                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="avatar bg-danger text-white rounded-circle mr-3"
                                                         style="width:40px;height:40px;">
                                                        <i class="fas fa-hat-chef"></i>
                                                    </div>
                                                    <strong>@item.NameSurname</strong>
                                                </div>
                                            </td>

                                            <td>
                                                <span class="badge badge-light px-3 py-2">
                                                    @item.Title
                                                </span>
                                            </td>

                                            <td>
                                                <span class="text-muted">
                                                    @(item.Description?.Length > 60
                                                                                                    ? item.Description.Substring(0, 60) + "..."
                                                                                                    : item.Description)
                                            </span>
                                        </td>

                                            <td class="text-right">
                                                <a href="/Chef/UpdateChef/@item.ChefID"
                                                   class="btn btn-outline-primary btn-sm mr-2"
                                                   title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>

                                                <a href="/Chef/DeleteChef/@item.ChefID"
                                                   class="btn btn-outline-danger btn-sm"
                                                   title="Delete"
                                                   onclick="return confirm('Are you sure you want to delete this chef?');">
                                                    <i class="fas fa-trash-alt"></i>
                                                </a>
                                            </td>
                                        </tr>
                                                                        }
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>




