
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Admin/Index.cshtml";
}

<section class="section">
    @await Component.InvokeAsync("_PartialWidget")
    @await Component.InvokeAsync("_PartialMainChart")
    <div class="row">
        <div class="col-12 col-sm-12 col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h4>Chart</h4>
                </div>
                <div class="card-body">
                    <div id="chart4" class="chartsh"></div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-12 col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h4>Chart</h4>
                </div>
                <div class="card-body">
                    <div class="summary">
                        <div class="summary-chart active" data-tab-group="summary-tab" id="summary-chart">
                            <div id="chart3" class="chartsh"></div>
                        </div>
                        <div data-tab-group="summary-tab" id="summary-text">
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-12 col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h4>Chart</h4>
                </div>
                <div class="card-body">
                    <div id="chart2" class="chartsh"></div>
                </div>
            </div>
        </div>
    </div>
    @await Component.InvokeAsync("_PartialGroupReservation")
    <div class="row">
        @await Component.InvokeAsync("_PartialTodayReservations")
        @await Component.InvokeAsync("_PartialUpcomingReservations")
    </div>
</section>

@await Component.InvokeAsync("_PartialDashboardScript")



