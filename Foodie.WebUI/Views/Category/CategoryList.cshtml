@model List<ResultCategoryDto>

@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Admin/Index.cshtml";
}

<section class="section">
    <div class="section-body">
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h4 class="mb-0">
                            <i class="fas fa-tags text-primary mr-2"></i>
                            Categories
                        </h4>

                        <a href="/Category/CreateCategory"
                           class="btn btn-success btn-sm">
                            <i class="fas fa-plus mr-1"></i>
                            New Category
                        </a>
                    </div>

                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="thead-light">
                                    <tr>
                                        <th style="width:60px;">#</th>
                                        <th>Category Name</th>
                                        <th class="text-right" style="width:180px;">Actions</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @if (!Model.Any())
                                    {
                                        <tr>
                                            <td colspan="3" class="text-center text-muted py-4">
                                                No categories found
                                            </td>
                                        </tr>
                                    }

                                    @foreach (var item in Model)
                                    {
                                        <tr>
                                            <td class="font-weight-bold">
                                                @item.CategoryID
                                            </td>

                                            <td>
                                                <span class="badge badge-light px-3 py-2">
                                                    @item.CategoryName
                                                </span>
                                            </td>

                                            <td class="text-right">
                                                <a href="/Category/UpdateCategory/@item.CategoryID"
                                                   class="btn btn-outline-primary btn-sm mr-2">
                                                    <i class="fas fa-edit"></i>
                                                </a>

                                                <a href="/Category/DeleteCategory/@item.CategoryID"
                                                   class="btn btn-outline-danger btn-sm"
                                                   onclick="return confirm('Are you sure you want to delete this category?');">
                                                    <i class="fas fa-trash-alt"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>




